{
  "name": "torch-monkey",
  "version": "0.6.0",
  "description": "Torch Monkey — Wota-艺 (wotagei) 3D choreography & visualization software",
  "author": "nazuki",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:win": "electron-vite build && electron-builder --win",
    "build:web": "vite build --config vite.config.web.ts",
    "dev:web": "vite --config vite.config.web.ts",
    "py:server": "python python/server.py",
    "py:models": "python python/scripts/download_models.py",
    "py:selftest": "python python/tools/selftest_pipeline.py",
    "py:check": "python python/tools/check_env.py",
    "py:dashboard": "python python/tools/dashboard.py",
    "setup": "node scripts/setup.mjs",
    "setup:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "setup:linux": "bash scripts/setup.sh"
  },
  "dependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/gui": "^9.0.0",
    "@babylonjs/loaders": "^9.0.0",
    "@babylonjs/materials": "^9.0.0",
    "@babylonjs/post-processes": "^9.0.0",
    "better-sqlite3": "^11.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^10.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
